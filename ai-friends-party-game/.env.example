# Optional. The game works without this using local fallback generation.
OPENAI_API_KEY=

# Optional model override. Keep configurable because API/model availability changes.
OPENAI_MODEL=gpt-4.1-mini

# Optional server port.
PORT=3000

# Banter strength: 1 = light, 5 = strong. The safety layer still avoids sensitive/personal-harmful areas.
BANTER_LEVEL=4
